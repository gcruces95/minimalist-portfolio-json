---
import Section from "../Section.astro"

import { work } from "@cv/"
---

<Section title="Experiencia laboral">
    <ul>
        {
        work.map(
            ({ name, startDate, endDate, position, summary, highlights, url }) => {
            const startYear = new Date(startDate).getFullYear()
            const endYear =
                endDate != null ? new Date(endDate).getFullYear() : "Actual"

            return (
                <li>
                <article>
                    <header>
                    <div>
                        <h3>
                        <a href={url} title={`Ver ${name}`} target="_blank">
                            {name}
                        </a>
                        </h3>
                        <h4>{position}</h4>
                    </div>

                    <div>
                        <time 
                        datetime={startDate}
                        data-title={startDate}>
                            {startYear}
                        </time>
                        {" - "}
                        <time 
                        datetime={endDate}
                        data-title={endDate}>
                            {endYear}
                        </time>
                    </div>
                    </header>

                    <footer>
                    <p>{summary}</p>
                    {highlights.map((highlight) => {
                        return <span>{highlight}</span>
                    })}
                    </footer>
                </article>
                </li>
            )
            }
        )
        }
    </ul>
</Section>

    <style>
    ul {
        display: flex;
        flex-direction: column;
        gap: 32px;
    }

    article h3 {
        font-weight: 500;
        color: var(--text-primary);
    }

    article a {
        color: var(--text-primary);
    }

    article a:hover {
        text-decoration: underline;
        color: var(--accent-color);
    }

    article h4 {
        color: var(--text-secondary);
        font-weight: 500;
    }

    header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-bottom: 4px;
    }

    time {
        color: var(--text-tertiary);
        font-size: 0.85rem;
        min-width: 102px;
        cursor: default;
    }

    [data-title]:hover:after {
        opacity: 1;
        transition: all 0.1s ease-in-out 0.5s;
        visibility: visible;
    }

    [data-title]:after {
        content: attr(data-title);
        background-color: var(--bg-secondary);
        color: var(--text-primary);
        border: 1px solid var(--border-color);
        font-size: .75rem;
        font-family: Menlo, Monaco, Lucida Console, "Courier New", monospace;;
        position: absolute;
        padding: .2rem .5rem;
        bottom: -1.4rem;
        left: 50%;
        white-space: nowrap;
        box-shadow: 0 2px 8px var(--shadow-color);
        opacity: 0;
        z-index: 99999;
        visibility: hidden;
        border-radius: 6px;
    }

    [data-title] {
        position: relative;
    }

    footer span {
        margin-top: 10px;
        display: flex;
        flex-direction: column;
        gap: 5px;
        background-color: var(--bg-secondary);
        border: 1px solid var(--border-color);
        padding: 8px;
        border-radius: 4px;
        font-size: 0.7rem;
        line-height: 1.4;
        color: var(--text-secondary);
    }

    @media (width <= 700px) {
        time {
        text-align: right;
        }
    }
</style>