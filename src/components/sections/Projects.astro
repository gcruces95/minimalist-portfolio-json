---
import GitHub from "@/icons/GitHub.astro"
import Section from "../Section.astro"

import { projects } from "@cv/"
---

<Section title="Proyectos">
    <ul>
        {
        projects.map(
            ({ url, description, highlights, name, isActive, github, category }) => {
            return (
                <li>
                <article class={category ? `project-${category.toLowerCase()}` : ''}>
                    <div class="category-indicator"></div>
                    <header>
                    <h3>
                        <a href={url} target="_blank" title={`Ver el proyecto ${name}`}>
                        {name}
                        </a>
                        {isActive && <span class="active-dot">•</span>}
                        {github && (
                        <a
                            class="github-code-link"
                            href={github}
                            target="_blank"
                            title={`Ver código fuente del proyecto ${name}`}
                        >
                            <GitHub />
                        </a>
                        )}
                    </h3>
                    {category && <div class="category-tag">{category}</div>}
                    <p>{description}</p>
                    </header>
                    <footer>
                    {highlights.map((highlight) => {
                        return <span>{highlight}</span>
                    })}
                    </footer>
                </article>
                </li>
            )
            }
        )
        }
    </ul>
</Section>

<style>
    ul {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 1.5rem;
        margin-inline: -16px;
    }

    article {
        border-radius: 12px;
        background: var(--bg-primary);
        border: 1px solid var(--border-color);
        box-shadow: 0 4px 12px var(--shadow-color);
        gap: 16px;
        display: flex;
        flex-direction: column;
        padding: 18px;
        height: 100%;
        position: relative;
        overflow: hidden;
        transition: transform 0.3s ease, box-shadow 0.3s ease, background-color 0.3s ease, border-color 0.3s ease;
    }

    article:hover {
        transform: translateY(-5px);
        box-shadow: 0 10px 20px var(--shadow-color);
        background: var(--bg-secondary);
    }

    .category-indicator {
        position: absolute;
        top: 0;
        left: 0;
        height: 4px;
        width: 100%;
        background: var(--border-color);
    }

    /* Estilos específicos por categoría */
    .project-frontend .category-indicator {
        background: linear-gradient(90deg, #61dafb, #00b0ff);
    }

    .project-backend .category-indicator {
        background: linear-gradient(90deg, #68a063, #43a047);
    }

    .project-fullstack .category-indicator {
        background: linear-gradient(90deg, #8957e5, #6a1b9a);
    }

    article header {
        flex: 1;
    }

    article h3 {
        margin-bottom: 8px;
        display: flex;
        align-items: center;
        gap: 5px;
        font-size: 1.1rem;
        color: var(--text-primary);
    }

    article a {
        color: var(--text-primary);
        transition: color 0.2s ease;
    }

    article a:hover {
        text-decoration: none;
        color: var(--accent-color);
    }

    article p {
        font-size: 0.8rem;
        line-height: 1.4rem;
        margin: 8px 0 12px;
        color: var(--text-secondary);
    }

    article h3 .active-dot {
        color: rgb(0, 188, 47);
        animation-name: flicker;
        animation-duration: 3s;
        animation-timing-function: ease-in;
        animation-iteration-count: infinite;
        font-size: 1.2rem;
    }

    .category-tag {
        display: inline-block;
        font-size: 0.65rem;
        font-weight: 600;
        padding: 0.2rem 0.7rem;
        border-radius: 20px;
        margin-bottom: 8px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .project-frontend .category-tag {
        background-color: rgba(97, 218, 251, 0.1);
        color: #0288d1;
        border: 1px solid rgba(97, 218, 251, 0.2);
    }

    .project-backend .category-tag {
        background-color: rgba(104, 160, 99, 0.1);
        color: #2e7d32;
        border: 1px solid rgba(104, 160, 99, 0.2);
    }

    .project-fullstack .category-tag {
        background-color: rgba(137, 87, 229, 0.1);
        color: #7b1fa2;
        border: 1px solid rgba(137, 87, 229, 0.2);
    }

    footer {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
        margin-top: 8px;
    }

    footer span {
        border-radius: 20px;
        background: var(--bg-secondary);
        color: var(--text-secondary);
        border: 1px solid var(--border-color);
        font-size: 0.65rem;
        font-weight: 500;
        padding: 0.3rem 0.8rem;
        transition: background-color 0.2s ease, transform 0.2s ease, border-color 0.2s ease;
    }

    footer span:hover {
        background: var(--bg-hover);
        border-color: var(--border-hover);
        transform: scale(1.05);
    }

    .project-frontend footer span:hover {
        background-color: rgba(97, 218, 251, 0.1);
        border-color: rgba(97, 218, 251, 0.3);
    }

    .project-backend footer span:hover {
        background-color: rgba(104, 160, 99, 0.1);
        border-color: rgba(104, 160, 99, 0.3);
    }

    .project-fullstack footer span:hover {
        background-color: rgba(137, 87, 229, 0.1);
        border-color: rgba(137, 87, 229, 0.3);
    }

    .github-code-link {
        margin-left: 5px;
        display: flex;
        align-items: center;
        transition: transform 0.2s ease;
    }

    .github-code-link:hover {
        transform: scale(1.1);
    }

    @keyframes flicker {
        0% {
        opacity: 1;
        }
        50% {
        opacity: 0.25;
        }
        100% {
        opacity: 1;
        }
    }

    @media (width <= 700px) {
        ul {
            margin-inline: 0px;
            gap: 1rem;
        }

        article {
            border-radius: 8px;
            padding: 16px;
            box-shadow: 0 2px 8px var(--shadow-color);
        }

        article h3 {
            font-size: 1rem;
        }

        .category-tag {
            font-size: 0.6rem;
            padding: 0.15rem 0.5rem;
        }
    }

    @media print {
        article {
            box-shadow: none;
            border: 1px solid var(--border-color);
        }

        article h3 .active-dot {
            animation-name: none;
        }
    }
</style>